# =============================================================================
# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars — it contains secrets.
# It's already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Region
# -----------------------------------------------------------------------------
# Which region to deploy into. Must have AgentCore available.
aws_region = "us-west-2"

# -----------------------------------------------------------------------------
# Project Name
# -----------------------------------------------------------------------------
# Used as a prefix for all resource names. Keep it short, lowercase, hyphens ok.
# Changing this after deploy will recreate all resources.
project_name = "agentcore-mcp"

# -----------------------------------------------------------------------------
# GitHub App (NOT OAuth App)
# -----------------------------------------------------------------------------
# The GitHub MCP server uses Authorization Code flow, which requires a
# GitHub App (not a classic OAuth App).
#
# 1. Go to https://github.com/settings/apps
# 2. Click "New GitHub App"
# 3. Fill in:
#      GitHub App name:              AgentCore Gateway GitHub MCP
#      Homepage URL:                 http://localhost:3000
#      Authorization callback URL:   https://example.com/auth (update later — see below)
# 4. Under Permissions, set what you need (e.g., Repository: Read & Write)
# 5. Click "Create GitHub App"
# 6. Copy the Client ID (NOT the App ID) → paste below
# 7. Click "Generate a new client secret" → paste below
#
# IMPORTANT: After terraform apply, get the callback URL from the credential provider:
#   aws bedrock-agentcore-control get-oauth2-credential-provider \
#     --name agentcore_mcp_github_oauth --region us-west-2
# Then go back to your GitHub App settings and update the
# "Authorization callback URL" to the value from AgentCore Identity.
#
github_oauth_client_id     = ""
github_oauth_client_secret = ""

# -----------------------------------------------------------------------------
# StackHawk API Key
# -----------------------------------------------------------------------------
# 1. Go to https://app.stackhawk.com
# 2. Log in (or sign up for a free account)
# 3. Navigate to Settings → API Keys (or for Vibe plan, it's on the main page)
# 4. Generate a new API key
# 5. Copy the key here (starts with "hawk.")
#
stackhawk_api_key = ""

# -----------------------------------------------------------------------------
# OAuth2 Callback URLs (Cognito Hosted UI)
# -----------------------------------------------------------------------------
# Where Cognito redirects after login. Must match your frontend app.
#
# Local development:
callback_urls = ["http://localhost:3000/callback"]
logout_urls   = ["http://localhost:3000"]
#
# Production example:
# callback_urls = ["https://myapp.example.com/callback"]
# logout_urls   = ["https://myapp.example.com"]
